# `first` and `from` are reserved TypeQL keywords, hence first-entity and source/target.
# The attribute labels A and B mirror generate.py's CSV column names (TypeQL labels are
# usually lower-case). `@key` makes id unique and required, so the relation template can
# look an entity up by its id.
define
  attribute id, value integer;
  attribute A, value integer;
  attribute B, value integer;

  entity first-entity,
    owns id @key,
    owns A,
    owns B,
    plays between:source;

  entity second-entity,
    owns id @key,
    owns A,
    owns B,
    plays between:target;

  relation between,
    relates source,
    relates target;
